---
import Seller from '../../../views/Seller.astro';
import NotFound from '../../../views/NotFound.astro';
import { sellerBySlug } from '../../../lib/pages-db';

const seller = await sellerBySlug(String(Astro.params.slug ?? ''));
if (!seller) Astro.response.status = 404;
---
{seller ? <Seller lang="en" seller={seller} /> : <NotFound lang="en" />}
