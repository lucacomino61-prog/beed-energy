---
// A-01 Dashboard: week/month orders and sales, commission (admin), 30-day bars, open orders, low stock,
// best sellers and the queue of things waiting for action. Sellers see only their own lines.
import Admin from '../../layouts/Admin.astro';
import { adminCtx } from '../../lib/admin-panel';
import { dashboard, isAdmin } from '../../lib/admin';
import { groupDigits, lek } from '../../lib/money';

const c = adminCtx(Astro);
if ('redirect' in c) return Astro.redirect(c.redirect, 303);
const { lang, t, user, url, flash } = c;
const admin = isAdmin(user);
const d = dashboard(user);

// 30 calendar days ending today (UTC, like SQLite's date()).
const byDay = new Map(d.byDay.map((r) => [r.day, r]));
const days = Array.from({ length: 30 }, (_, i) => {
  const dt = new Date(Date.now() - (29 - i) * 864e5);
  const key = dt.toISOString().slice(0, 10);
  return { key, label: `${key.slice(8, 10)}.${key.slice(5, 7)}`, revenue: byDay.get(key)?.revenue ?? 0, orders: byDay.get(key)?.orders ?? 0 };
});
const max = Math.max(0, ...days.map((x) => x.revenue));
const peakIdx = max > 0 ? days.findIndex((x) => x.revenue === max) : -1;
const W = 900;
const H = 230;
const base = 196;
const top = 30;
const slot = W / days.length;
const bw = slot * 0.58;
const bh = (v: number) => (max > 0 ? Math.max(v > 0 ? 2 : 0, ((base - top) * v) / max) : 0);

const kpi = (n: number) => groupDigits(n);
const cells = [
  { label: t.dash.open, sub: t.dash.openHint, n: d.open, unit: '', tone: 'ink', href: '/admin/orders?status=new' },
  { label: `${t.dash.orders} · ${t.dash.week}`, n: d.week.orders, unit: '' },
  { label: `${t.dash.revenue} · ${t.dash.week}`, n: d.week.revenue, unit: t.common.lek },
  { label: `${t.dash.orders} · ${t.dash.month}`, n: d.month.orders, unit: '' },
  { label: `${t.dash.revenue} · ${t.dash.month}`, n: d.month.revenue, unit: t.common.lek },
  ...(admin ? [{ label: `${t.dash.commission} · ${t.dash.month}`, n: d.month.commission, unit: t.common.lek, tone: 'copper' }] : []),
] as { label: string; sub?: string; n: number; unit: string; tone?: string; href?: string }[];

const counts = d.counts as Record<string, number>;
const countLinks: Record<string, string> = {
  applications: '/admin/applications',
  quotes: '/admin/quotes?status=open',
  messages: '/admin/messages?state=open',
  noOffer: '/admin/monitor#none',
  products: '/admin/products?status=published',
  sellers: '/admin/sellers',
  offers: '/admin/offers',
};
const hot = new Set(['applications', 'quotes', 'messages', 'noOffer']);
---
<Admin lang={lang} t={t} user={user} url={url} title={t.dash.title} section="dashboard" flash={flash} sheet={[[t.dash.open, d.open]]}>
  <section class="adm-sec" aria-labelledby="h-kpi">
    <h2 class="adm-h2 visually-hidden" id="h-kpi">{t.dash.title}</h2>
    <div class="kpis">
      {cells.map((k) => {
        const s = kpi(k.n);
        return (
          <div class:list={['kpi', { 'kpi--ink': k.tone === 'ink', 'kpi--copper': k.tone === 'copper' }]}>
            <p class="kpi__label"><span>{k.label}</span></p>
            <p class="kpi__n" style={`--len:${s.length + (k.unit ? 1 : 0)}`}>{k.href ? <a href={k.href}>{s}</a> : s}{k.unit && <small>{k.unit}</small>}</p>
            {k.sub && <p class="kpi__sub">{k.sub}</p>}
          </div>
        );
      })}
    </div>
    <p class="small muted" style="margin-top: 0.75rem">{admin ? t.dash.revenueNote : `${t.dash.sellerNote} ${t.dash.revenueNote}`}</p>
  </section>

  <section class="adm-sec" aria-labelledby="h-chart">
    <h2 class="adm-h2" id="h-chart"><span class="k">01</span>{t.dash.chart}</h2>
    <div class="chart-box">
      {max === 0 ? <p class="muted">{t.dash.chartEmpty}</p> : null}
      <svg class="bars" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${t.dash.chart}. ${max > 0 ? `${days[peakIdx].label}: ${lek(max, lang)}` : t.dash.chartEmpty}`}>
        <line class="grid" x1="0" x2={W} y1={top} y2={top} />
        <line class="grid" x1="0" x2={W} y1={(top + base) / 2} y2={(top + base) / 2} />
        {days.map((x, i) => {
          const h = bh(x.revenue);
          return <rect class:list={['bar', { 'bar--peak': i === peakIdx }]} x={(i * slot + (slot - bw) / 2).toFixed(1)} y={(base - h).toFixed(1)} width={bw.toFixed(1)} height={h.toFixed(1)} />;
        })}
        <line class="axis" x1="0" x2={W} y1={base} y2={base} />
        {[0, 14, 29].map((i) => <text x={(i * slot + slot / 2).toFixed(1)} y={base + 22} text-anchor={i === 0 ? 'start' : i === 29 ? 'end' : 'middle'}>{days[i].label}</text>)}
        {peakIdx >= 0 && (
          <g>
            <line class="axis" x1={(peakIdx * slot + slot / 2).toFixed(1)} x2={(peakIdx * slot + slot / 2).toFixed(1)} y1={(base - bh(max) - 4).toFixed(1)} y2={top - 14} stroke-dasharray="2 3" />
            <text class="lbl-peak" x={(peakIdx * slot + slot / 2).toFixed(1)} y={top - 18} text-anchor={peakIdx > 24 ? 'end' : peakIdx < 5 ? 'start' : 'middle'}>{days[peakIdx].label} · {lek(max, lang)}</text>
          </g>
        )}
      </svg>
      <details style="margin-top: 0.5rem">
        <summary class="small" style="min-height: 44px; display: flex; align-items: center; cursor: pointer">{t.common.asTable}</summary>
        <div class="table-scroll">
          <table class="table adm-table">
            <thead><tr><th scope="col">{t.dash.day}</th><th scope="col" class="num">{t.dash.orders}</th><th scope="col" class="num">{t.dash.revenue}</th></tr></thead>
            <tbody>
              {days.filter((x) => x.orders > 0).map((x) => <tr><th scope="row" class="mono" style="font-weight: 400">{x.key}</th><td class="num mono">{x.orders}</td><td class="num price">{lek(x.revenue, lang)}</td></tr>)}
            </tbody>
          </table>
        </div>
      </details>
    </div>
  </section>

  <div class="adm-cols adm-sec">
    <section aria-labelledby="h-queue">
      <h2 class="adm-h2" id="h-queue"><span class="k">02</span>{t.dash.queue}</h2>
      <div class="counts">
        {Object.entries(counts).map(([k, n]) => (
          <a href={countLinks[k] ?? '/admin'}><span class="l">{t.dash.counts[k] ?? k}</span><span class="n" data-hot={hot.has(k) && n > 0 ? 'true' : 'false'}>{n}</span></a>
        ))}
      </div>
    </section>
    <section aria-labelledby="h-low">
      <h2 class="adm-h2" id="h-low"><span class="k">03</span>{t.dash.lowStock}<span class="meta">{t.dash.lowStockHint}</span></h2>
      {d.lowStock.length === 0 ? <p class="adm-empty">{t.dash.lowStockEmpty}</p> : (
        <div class="table-scroll">
          <table class="table adm-table">
            <thead><tr><th scope="col">{t.offers.product}</th>{admin && <th scope="col">{t.offers.seller}</th>}<th scope="col" class="num">{t.offers.stock}</th></tr></thead>
            <tbody>
              {d.lowStock.map((o: any) => (
                <tr>
                  <td><a class="rowlink" href={`/admin/offers/${o.id}`}><span translate="no">{o.brand} {o.model}</span></a></td>
                  {admin && <td>{o.seller}</td>}
                  <td class="num mono">{o.stock_qty}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>

  <section class="adm-sec" aria-labelledby="h-top">
    <h2 class="adm-h2" id="h-top"><span class="k">04</span>{t.dash.top}</h2>
    {d.topProducts.length === 0 ? <p class="adm-empty">{t.dash.topEmpty}</p> : (
      <div class="table-scroll">
        <table class="table adm-table">
          <thead><tr><th scope="col">{t.offers.product}</th><th scope="col" class="num">{t.dash.qty}</th><th scope="col" class="num">{t.dash.revenue}</th></tr></thead>
          <tbody>
            {d.topProducts.map((p: any) => (
              <tr>
                <td>{p.product_id ? <a class="rowlink" href={admin ? `/admin/products/${p.product_id}` : `/admin/offers?q=${encodeURIComponent(p.product_name)}`}><span translate="no">{p.product_name}</span></a> : <span translate="no">{p.product_name}</span>}</td>
                <td class="num mono">{p.qty}</td>
                <td class="num price">{lek(p.revenue, lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</Admin>
