---
// A-01 Dashboard: the week and month in figures, what is waiting for action, low stock, sales per day,
// orders by status, sales by category, best sellers and (staff) how much of the catalogue has photos.
// Sellers see only their own lines everywhere.
import Admin from '../../layouts/Admin.astro';
import ColumnChart from './_parts/ColumnChart.astro';
import BarList from './_parts/BarList.astro';
import { adminCtx } from '../../lib/admin-panel';
import { dashboard, isAdmin } from '../../lib/admin';
import { date } from '../../lib/i18n';
import { groupDigits, lek } from '../../lib/money';

const c = adminCtx(Astro);
if ('redirect' in c) return Astro.redirect(c.redirect, 303);
const { lang, t, user, url, flash } = c;
const admin = isAdmin(user);
const d = await dashboard(user);

// 30 calendar days ending today (UTC, like SQLite's date()).
const byDay = new Map(d.byDay.map((r) => [r.day, r]));
const days = Array.from({ length: 30 }, (_, i) => {
  const key = new Date(Date.now() - (29 - i) * 864e5).toISOString().slice(0, 10);
  const r = byDay.get(key);
  const revenue = r?.revenue ?? 0;
  return { key, label: `${key.slice(8, 10)}.${key.slice(5, 7)}`, long: date(key, lang), value: revenue, valueText: lek(revenue, lang), extra: r?.orders ? t.dash.ordersN(r.orders) : undefined };
});
/** Axis ticks in lekë, compact from a thousand up: 0 · 25K · 50K · 1.5M. */
const tick = (n: number) => (n >= 1e6 ? `${(n / 1e6).toFixed(n % 1e6 ? 1 : 0)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}K` : String(Math.round(n)));

const ORDER_FLOW = ['new', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled'];
const statusN = new Map(d.byStatus.map((r) => [r.status, r.n]));
const statusItems = ORDER_FLOW.filter((s) => (statusN.get(s) ?? 0) > 0).map((s) => {
  const n = statusN.get(s)!;
  return { label: t.status[s] ?? s, value: n, valueText: t.dash.ordersN(n), href: `/admin/orders?status=${s}` };
});
const categoryItems = d.byCategory.map((r) => ({ label: lang === 'sq' ? r.name_sq : r.name_en, sub: t.dash.pieces(r.qty), value: r.revenue, valueText: lek(r.revenue, lang) }));
const topItems = d.topProducts.map((p: any) => ({
  label: p.product_name,
  sub: t.dash.pieces(p.qty),
  value: p.revenue,
  valueText: lek(p.revenue, lang),
  href: p.product_id ? (admin ? `/admin/products/${p.product_id}` : `/admin/offers?q=${encodeURIComponent(p.product_name)}`) : undefined,
}));
const photos = d.photos;
const photoShare = photos && photos.total ? photos.with_photo / photos.total : 0;

const kpi = (n: number) => groupDigits(n);
const cells = [
  { label: t.dash.open, sub: t.dash.openHint, n: d.open, unit: '', tone: 'ink', href: '/admin/orders?status=new' },
  { label: `${t.dash.orders} · ${t.dash.week}`, n: d.week.orders, unit: '' },
  { label: `${t.dash.revenue} · ${t.dash.week}`, n: d.week.revenue, unit: t.common.lek },
  { label: `${t.dash.orders} · ${t.dash.month}`, n: d.month.orders, unit: '' },
  { label: `${t.dash.revenue} · ${t.dash.month}`, n: d.month.revenue, unit: t.common.lek },
  ...(admin ? [{ label: `${t.dash.commission} · ${t.dash.month}`, n: d.month.commission, unit: t.common.lek, tone: 'copper' }] : []),
] as { label: string; sub?: string; n: number; unit: string; tone?: string; href?: string }[];
const counts = d.counts as Record<string, number>;
const countLinks: Record<string, string> = {
  applications: '/admin/applications',
  quotes: '/admin/quotes?status=open',
  messages: '/admin/messages?state=open',
  noOffer: '/admin/monitor#none',
  products: '/admin/products?status=published',
  sellers: '/admin/sellers',
  offers: '/admin/offers',
};
const hot = new Set(['applications', 'quotes', 'messages', 'noOffer']);
---
<Admin lang={lang} t={t} user={user} url={url} title={t.dash.title} section="dashboard" flash={flash} sheet={[[t.dash.open, d.open]]}>
  <section class="adm-sec" aria-labelledby="h-kpi">
    <h2 class="adm-h2 visually-hidden" id="h-kpi">{t.dash.title}</h2>
    <div class="kpis">
      {cells.map((k) => {
        const s = kpi(k.n);
        return (
          <div class:list={['kpi', { 'kpi--ink': k.tone === 'ink', 'kpi--copper': k.tone === 'copper' }]}>
            <p class="kpi__label"><span>{k.label}</span></p>
            <p class="kpi__n" style={`--len:${s.length + (k.unit ? 1 : 0)}`}>{k.href ? <a href={k.href}>{s}</a> : s}{k.unit && <small>{k.unit}</small>}</p>
            {k.sub && <p class="kpi__sub">{k.sub}</p>}
          </div>
        );
      })}
    </div>
    <p class="small muted" style="margin-top: 0.75rem">{admin ? t.dash.revenueNote : `${t.dash.sellerNote} ${t.dash.revenueNote}`}</p>
  </section>

  <div class="adm-cols adm-sec">
    <section aria-labelledby="h-queue">
      <h2 class="adm-h2" id="h-queue"><span class="k">01</span>{t.dash.queue}</h2>
      <div class="counts">
        {Object.entries(counts).map(([k, n]) => (
          <a href={countLinks[k] ?? '/admin'}><span class="l">{t.dash.counts[k] ?? k}</span><span class="n" data-hot={hot.has(k) && n > 0 ? 'true' : 'false'}>{n}</span></a>
        ))}
      </div>
    </section>
    <section aria-labelledby="h-low">
      <h2 class="adm-h2" id="h-low"><span class="k">02</span>{t.dash.lowStock}<span class="meta">{t.dash.lowStockHint}</span></h2>
      {d.lowStock.length === 0 ? <p class="adm-empty">{t.dash.lowStockEmpty}</p> : (
        <div class="table-scroll">
          <table class="table adm-table">
            <thead><tr><th scope="col">{t.offers.product}</th>{admin && <th scope="col">{t.offers.seller}</th>}<th scope="col" class="num">{t.offers.stock}</th></tr></thead>
            <tbody>
              {d.lowStock.map((o: any) => (
                <tr>
                  <td><a class="rowlink" href={`/admin/offers/${o.id}`}><span translate="no">{o.brand} {o.model}</span></a></td>
                  {admin && <td>{o.seller}</td>}
                  <td class="num mono">{o.stock_qty}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>

  <section class="adm-sec" aria-labelledby="h-chart">
    <h2 class="adm-h2" id="h-chart"><span class="k">03</span>{t.dash.chart}</h2>
    <div class="chart-box">
      <ColumnChart title={t.dash.chart} points={days} tick={tick} hint={t.dash.chartHint} asTable={t.common.asTable} head={[t.dash.day, t.dash.orders, t.dash.revenue]} empty={t.dash.chartEmpty} />
    </div>
  </section>

  <div class="adm-cols adm-sec">
    <section aria-labelledby="h-status">
      <h2 class="adm-h2" id="h-status"><span class="k">04</span>{t.dash.byStatus}</h2>
      {statusItems.length === 0 ? <p class="adm-empty">{t.dash.byStatusEmpty}</p> : <BarList label={t.dash.byStatus} items={statusItems} tone="ink" />}
    </section>
    <section aria-labelledby="h-cat">
      <h2 class="adm-h2" id="h-cat"><span class="k">05</span>{t.dash.byCategory}</h2>
      {categoryItems.length === 0 ? <p class="adm-empty">{t.dash.byCategoryEmpty}</p> : <BarList label={t.dash.byCategory} items={categoryItems} />}
    </section>
  </div>

  <div class="adm-cols adm-sec">
    <section aria-labelledby="h-top">
      <h2 class="adm-h2" id="h-top"><span class="k">06</span>{t.dash.top}</h2>
      {topItems.length === 0 ? <p class="adm-empty">{t.dash.topEmpty}</p> : <BarList label={t.dash.top} items={topItems} />}
    </section>
    {photos && (
      <section aria-labelledby="h-photos">
        <h2 class="adm-h2" id="h-photos"><span class="k">07</span>{t.dash.photosTitle}</h2>
        <div class="meter">
          <p class="meter__n">{photos.with_photo}<small> / {photos.total}</small></p>
          <div class="meter__track" role="meter" aria-valuemin="0" aria-valuemax={photos.total} aria-valuenow={photos.with_photo} aria-label={t.dash.photosOf(photos.with_photo, photos.total)}>
            <span class="meter__fill" style={`--v:${photoShare.toFixed(4)}`} />
          </div>
          <p class="small">{t.dash.photosOf(photos.with_photo, photos.total)}</p>
          {photos.with_photo < photos.total
            ? <p><a class="btn btn--s btn--ghost" href="/admin/products?status=published&photo=none">{t.dash.photosGo(photos.total - photos.with_photo)}</a></p>
            : <p class="small muted">{t.dash.photosDone}</p>}
        </div>
      </section>
    )}
  </div>
</Admin>
