---
// Checkout on one page, numbered like a drawing sheet: 01 buyer, 02 delivery, 03 payment, 04 confirmation.
// The route runs checkoutPage() (lib/checkout-flow.ts) and passes its state here. Works without scripts;
// checkout.ts only re-prices the summary when the city or delivery method changes. No motion on this page.
import Site from '../layouts/Site.astro';
import '../styles/checkout.css';
import { href, other, type Lang } from '../lib/i18n';
import { lek, lekLong } from '../lib/money';
import { paymentMode } from '../lib/payments';
import { tco } from '../i18n/checkout';
import { jsonForScript } from '../lib/html';
import { cities, cityName, cityParam, codLimit, demoOffers, groupBySeller, pickupAvailable, productName, seenKey, sellerInfo } from '../lib/checkout-view';
import type { CheckoutState } from '../lib/checkout-flow';
import type { CheckoutValues } from '../lib/checkout';

interface Props { lang: Lang; state: CheckoutState }
const { lang, state } = Astro.props;
const t = tco(lang);
const v = state.values;
const errors = state.errors;
const q = state.quote;
const allCities = cities();
const city = allCities.find((c) => c.slug === v.city) ?? null;
const groups = groupBySeller(q);
const sellers = sellerInfo(groups.map((g) => g.sellerId));
const demo = demoOffers(q.lines.map((l) => l.offerId));
const limit = codLimit();
const mode = paymentMode(); // 'off' in production without POK keys: no card option at all
const pickupOn = pickupAvailable(); // settings → delivery → pickup from the seller
const alternate = href(other(lang), 'checkout', {}, city ? { [cityParam(other(lang))]: city.slug } : undefined);
// Lines carry the short tag form (12 400 L); parcel fees, totals and sentences the long one (12 400 lekë).
const fee = (n: number) => (n === 0 ? t.sum.free : lekLong(n, lang));

type Key = keyof CheckoutValues;
const ORDER: Key[] = ['customerType', 'name', 'phone', 'email', 'company', 'nipt', 'city', 'address', 'delivery', 'payment', 'terms'];
const errKeys = ORDER.filter((k) => errors[k]);
const first = errKeys[0];
const hints: Partial<Record<Key, true>> = { phone: true, email: true, nipt: true, address: true };
const a = (k: Key) => {
  const ids = [errors[k] ? `${k}-err` : '', hints[k] ? `${k}-hint` : ''].filter(Boolean).join(' ');
  return {
    'aria-invalid': errors[k] ? ('true' as const) : undefined,
    'aria-describedby': ids || undefined,
    autofocus: first === k ? true : undefined,
  };
};
const anyProblem = q.lines.some((l) => l.problem && !(l.problem === 'zone' && v.delivery === 'pickup'));
const clientWords = {
  free: t.sum.free,
  zone: t.cart.problem.zone('{city}'),
  noCity: t.cart.city.none,
  limit,
  lang,
};
---
<Site lang={lang} title={t.co.title} description={t.co.description} alternate={alternate} current="checkout" noindex hideTray nativeScroll bodyClass="is-checkout">
  <div class="wrap sheet-head co-head">
    <nav aria-label={lang === 'sq' ? 'Gjurma' : 'Breadcrumb'}>
      <ol class="crumbs">
        <li><a href={href(lang, 'home')}>{t.home}</a></li>
        <li><a href={href(lang, 'cart', {}, city ? { [cityParam(lang)]: city.slug } : undefined)}>{t.cart.h1}</a></li>
        <li aria-current="page">{t.co.eyebrow}</li>
      </ol>
    </nav>
    <h1 class="title title--xl co-title">{t.co.h1}</h1>
    <p class="lede co-intro">{t.co.intro}</p>
  </div>

  <div class="wrap co-body">
    {state.formError === 'rate' && <p class="notice notice--bad co-alert" role="alert">{t.co.rate}</p>}
    {state.formError === 'stale' && <p class="notice notice--bad co-alert" role="alert">{t.co.stale}</p>}
    {state.changes.length > 0 && (
      <div class="notice notice--bad co-alert" role="alert" tabindex="-1" autofocus={!first ? true : undefined}>
        <h2 class="co-alert__h">{t.co.changed.title}</h2>
        <p>{t.co.changed.intro}</p>
        <ul class="co-list">{state.changes.map((c) => <li>{c}</li>)}</ul>
        <a class="link-arrow small" href={href(lang, 'cart', {}, city ? { [cityParam(lang)]: city.slug } : undefined)}><span>{t.co.changed.fix}</span> <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    )}
    {errKeys.length > 0 && (
      <div class="form-errors co-alert" role="alert">
        <p><strong>{t.co.errors}</strong></p>
        <ul class="co-list">{errKeys.map((k) => <li><a href={`#f-${k}`}>{errors[k]}</a></li>)}</ul>
      </div>
    )}

    <div class="co-grid co-grid--checkout">
      <aside class="co-side" aria-labelledby="cosum-h">
        <details class="sumcard sumcard--co" open data-sum-details>
          <summary class="sumcard__toggle">
            <span>{t.co.show}</span>
            <span class="price" data-co="total-toggle">{lekLong(q.total, lang)}</span>
          </summary>
          <h2 class="eyebrow" id="cosum-h">{t.co.your}</h2>
          {groups.map((g, gi) => {
            const s = sellers.get(g.sellerId);
            const p = g.parcel;
            return (
              <div class="cosum__parcel" data-seller={g.sellerId}>
                <p class="cosum__seller">
                  <span class="key">{String(gi + 1).padStart(2, '0')}</span>
                  <span>{s?.name ?? g.lines[0].sellerName}</span>
                  {g.lines.some((l) => demo.has(l.offerId)) && <span class="tag tag--demo">{t.sample}</span>}
                </p>
                <ul class="cosum__lines" role="list">
                  {g.lines.map((l) => (
                    <li data-line={l.offerId} data-problem={l.problem ?? ''}>
                      <span class="cosum__name">{productName(l, lang)} <span class="mono muted">× {l.qty}</span></span>
                      <span class="price">{lek(l.lineTotal, lang)}</span>
                      <span class="cosum__warn small" data-warn hidden={!(l.problem && !(l.problem === 'zone' && v.delivery === 'pickup'))}>
                        {l.problem === 'zone' ? t.cart.problem.zone(city ? cityName(city, lang) : t.cart.city.none) : l.problem === 'stock' ? t.cart.problem.stock(l.stock) : l.problem === 'min' ? t.cart.problem.min(l.minQty) : l.problem === 'gone' ? t.cart.problem.gone : ''}
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="cosum__fee small">
                  <span>{t.sum.delivery}{g.lead > 0 && <span class="muted"> · {t.cart.lead(g.lead)}</span>}</span>
                  <span class="price" data-pfee>{p ? fee(p.fee) : '—'}</span>
                </p>
              </div>
            );
          })}
          <dl class="totals">
            <div><dt>{t.sum.subtotal}</dt><dd class="price" data-co="subtotal">{lekLong(q.subtotal, lang)}</dd></div>
            <div><dt>{t.sum.delivery}</dt><dd class="price" data-co="delivery">{fee(q.delivery)}</dd></div>
            <div class="totals__grand"><dt>{t.sum.total}</dt><dd class="price" data-co="total">{lekLong(q.total, lang)}</dd></div>
            <div class="totals__vat"><dt>{t.sum.vat}</dt><dd class="price" data-co="vat">{lekLong(q.vat, lang)}</dd></div>
          </dl>
          <a class="link-arrow small" href={href(lang, 'cart', {}, city ? { [cityParam(lang)]: city.slug } : undefined)}><span>{t.co.edit}</span></a>
        </details>
      </aside>

      <form class="co-form co-main" method="post" action={Astro.url.pathname} novalidate data-checkout-form>
        <div class="hp" aria-hidden="true">
          <label for="f-website">Website</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="seen" value={seenKey(q)} />
        <input type="hidden" name="seen_total" value={q.total} data-seen-total />
        <input type="hidden" name="nonce" value={state.nonce} />
        <input type="hidden" name="source" value={Astro.url.searchParams.get('burimi') ?? 'web'} />

        <section class="co-sec" aria-labelledby="s1">
          <h2 class="co-sec__h" id="s1"><span class="key">01</span> {t.co.s1}</h2>
          <fieldset class="co-fieldset" id="f-customerType">
            <legend class="label co-legend">{t.co.buyingAs}</legend>
            <div class="choice-row choice-row--2">
              <label class="choice">
                <input type="radio" name="customerType" value="individual" checked={v.customerType === 'individual'} />
                <span><strong>{t.co.individual}</strong><span class="hint small muted">{t.co.individualHint}</span></span>
              </label>
              <label class="choice">
                <input type="radio" name="customerType" value="business" checked={v.customerType === 'business'} />
                <span><strong>{t.co.business}</strong><span class="hint small muted">{t.co.businessHint}</span></span>
              </label>
            </div>
          </fieldset>
          <div class="co-fields">
            <div class="field co-span-2">
              <label for="f-name">{t.co.name}</label>
              <input class="input" id="f-name" name="name" type="text" autocomplete="name" value={v.name} aria-required="true" {...a('name')} />
              {errors.name && <p class="error" id="name-err">{errors.name}</p>}
            </div>
            <div class="field">
              <label for="f-phone">{t.co.phone}</label>
              <input class="input" id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="069 123 4567" value={v.phone} aria-required="true" {...a('phone')} />
              <p class="hint" id="phone-hint">{t.co.phoneHint}</p>
              {errors.phone && <p class="error" id="phone-err">{errors.phone}</p>}
            </div>
            <div class="field">
              <label for="f-email">{t.co.email}</label>
              <input class="input" id="f-email" name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" value={v.email} {...a('email')} />
              <p class="hint" id="email-hint">{t.co.emailHint}</p>
              {errors.email && <p class="error" id="email-err">{errors.email}</p>}
            </div>
            <div class="co-biz co-span-2" data-biz>
              <p class="hint small co-nojs-hint">{t.co.bizOnly}</p>
              <div class="co-fields">
                <div class="field">
                  <label for="f-company">{t.co.company}</label>
                  <input class="input" id="f-company" name="company" type="text" autocomplete="organization" value={v.company} {...a('company')} />
                  {errors.company && <p class="error" id="company-err">{errors.company}</p>}
                </div>
                <div class="field">
                  <label for="f-nipt">{t.co.nipt}</label>
                  <input class="input mono" id="f-nipt" name="nipt" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="12" placeholder="L12345678A" value={v.nipt} {...a('nipt')} />
                  <p class="hint" id="nipt-hint">{t.co.niptHint}</p>
                  {errors.nipt && <p class="error" id="nipt-err">{errors.nipt}</p>}
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="co-sec" aria-labelledby="s2">
          <h2 class="co-sec__h" id="s2"><span class="key">02</span> {t.co.s2}</h2>
          <fieldset class="co-fieldset" id="f-delivery" aria-describedby={errors.delivery ? 'delivery-err' : undefined}>
            <legend class="label co-legend">{t.co.method}</legend>
            {errors.delivery && <p class="error co-err-block" id="delivery-err">{errors.delivery}</p>}
            <div class:list={['choice-row', pickupOn && 'choice-row--2']}>
              <label class="choice">
                <input type="radio" name="delivery" value="courier" checked={v.delivery === 'courier' || !pickupOn} data-delivery />
                <span><strong>{t.delivery.courier}</strong><span class="hint small muted">{t.co.courierHint}</span></span>
              </label>
              {pickupOn && (
                <label class="choice">
                  <input type="radio" name="delivery" value="pickup" checked={v.delivery === 'pickup'} data-delivery />
                  <span><strong>{t.delivery.pickup}</strong><span class="hint small muted">{t.co.pickupHint}</span></span>
                </label>
              )}
            </div>
          </fieldset>
          {pickupOn && <div class="co-pickup small" data-pickup>
            <p class="eyebrow">{t.co.pickupFrom}</p>
            <ul class="co-list">
              {groups.map((g) => {
                const s = sellers.get(g.sellerId);
                const c = s ? (lang === 'sq' ? s.city_sq : s.city_en) : null;
                return <li>{s?.name ?? g.lines[0].sellerName}{c && <span class="muted"> · {c}</span>}</li>;
              })}
            </ul>
          </div>}
          <div class="co-fields">
            <div class="field">
              <label for="f-city">{t.co.city}</label>
              <select class="select" id="f-city" name="city" autocomplete="address-level2" aria-required="true" data-co-city {...a('city')}>
                <option value="" selected={!city}>{t.cart.city.choose}</option>
                {allCities.map((c) => <option value={c.slug} data-id={c.id} selected={city?.id === c.id}>{cityName(c, lang)}</option>)}
              </select>
              {errors.city && <p class="error" id="city-err">{errors.city}</p>}
            </div>
            <div class="field co-address co-span-2">
              <label for="f-address">{t.co.address}</label>
              <textarea class="textarea co-textarea-s" id="f-address" name="address" autocomplete="street-address" rows="2" {...a('address')}>{v.address}</textarea>
              <p class="hint" id="address-hint">{t.co.addressHint}</p>
              {errors.address && <p class="error" id="address-err">{errors.address}</p>}
            </div>
          </div>
        </section>

        <section class="co-sec" aria-labelledby="s3">
          <h2 class="co-sec__h" id="s3"><span class="key">03</span> {t.co.s3}</h2>
          <fieldset class="co-fieldset" id="f-payment" aria-describedby={errors.payment ? 'payment-err' : undefined}>
            <legend class="label co-legend">{t.co.payment}</legend>
            {errors.payment && <p class="error co-err-block" id="payment-err">{errors.payment}</p>}
            <div class="choice-row">
              <label class="choice" data-cod-choice>
                <input type="radio" name="payment" value="cod" checked={v.payment === 'cod' && q.codAllowed} disabled={!q.codAllowed} aria-describedby="cod-off" data-cod autofocus={first === 'payment' && q.codAllowed ? true : undefined} />
                <span>
                  <strong>{t.method.cod}</strong>
                  <span class="hint small muted">{t.co.codHint}</span>
                  <span class="hint small co-codoff" id="cod-off" data-cod-off hidden={q.codAllowed}>{t.co.codOff(lekLong(limit, lang))}</span>
                </span>
              </label>
              <label class="choice">
                <input type="radio" name="payment" value="bank" checked={v.payment === 'bank' || (v.payment === 'cod' && !q.codAllowed)} autofocus={first === 'payment' && !q.codAllowed ? true : undefined} />
                <span><strong>{t.method.bank}</strong><span class="hint small muted">{t.co.bankHint}</span></span>
              </label>
              {mode !== 'off' && (
                <label class="choice">
                  <input type="radio" name="payment" value="card" checked={v.payment === 'card'} />
                  <span>
                    <strong>{t.method.card}</strong>
                    <span class="hint small muted">{t.co.cardHint}</span>
                    {mode === 'test' && <span class="tag tag--ink co-testtag">{t.co.cardTest}</span>}
                  </span>
                </label>
              )}
            </div>
          </fieldset>
        </section>

        <section class="co-sec" aria-labelledby="s4">
          <h2 class="co-sec__h" id="s4"><span class="key">04</span> {t.co.s4}</h2>
          <div class="field">
            <label for="f-notes">{t.co.notes}</label>
            <textarea class="textarea co-textarea-s" id="f-notes" name="notes" rows="3" aria-describedby="notes-hint">{v.notes}</textarea>
            <p class="hint" id="notes-hint">{t.co.notesHint}</p>
          </div>

          <div class="co-final">
            <dl class="totals totals--final">
              <div class="totals__grand"><dt>{t.sum.total}</dt><dd class="price" data-co="total">{lekLong(q.total, lang)}</dd></div>
              <div class="totals__vat"><dt>{t.sum.vat}</dt><dd class="price" data-co="vat">{lekLong(q.vat, lang)}</dd></div>
            </dl>
            <p class="small muted">{t.sum.allIn} <span>{t.sum.delivery}: <span data-co="delivery">{fee(q.delivery)}</span>.</span></p>
            <ul class="co-legal small" role="list">
              <li>{t.co.legal.withdrawal} <a href={`${href(lang, 'terms')}#kthimet`}>{t.co.legal.withdrawalLink}</a></li>
              <li>{t.co.legal.delivery}</li>
              <li>{t.co.legal.guarantee}</li>
            </ul>
            <div class="field" id="f-terms">
              <label class="check">
                <input type="checkbox" name="terms" value="on" checked={v.terms} aria-required="true" {...a('terms')} />
                <span>{t.co.termsBefore}<a href={href(lang, 'terms')}>{t.co.termsLink}</a>{t.co.termsAfter}</span>
              </label>
              {errors.terms && <p class="error" id="terms-err">{errors.terms}</p>}
            </div>
            {anyProblem && <p class="notice notice--bad small" data-co-problem>{t.cart.fix} <a href={href(lang, 'cart', {}, city ? { [cityParam(lang)]: city.slug } : undefined)}>{t.co.edit}</a></p>}
            <button class="btn btn--block co-submit" type="submit">{t.co.submit}</button>
            <p class="small muted co-cardnote" data-card-note>{t.co.submitCard}</p>
            <p class="small muted">{t.co.privacy} <a href={href(lang, 'privacy')}>{t.co.privacyLink}</a></p>
          </div>
        </section>
      </form>
    </div>
  </div>
  <script type="application/json" id="checkout-words" set:html={jsonForScript(clientWords)} />
  <script>
    import '../scripts/checkout';
  </script>
</Site>
