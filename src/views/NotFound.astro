---
// 404 in the house world: an elevation of the house with one layer missing (dashed, in copper).
// Used by src/pages/404.astro and by routes whose record does not exist (seller, quote thread).
import Site from '../layouts/Site.astro';
import '../styles/pages.css';
import { href, other, type Lang } from '../lib/i18n';
import { tp } from '../i18n/pages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const w = tp(lang);
const t = w.notFound;
// Layer bands from the ground up; index 3 (the windows) is the missing one.
const layers = [
  { y: 300, h: 40, key: '01' },
  { y: 262, h: 38, key: '02' },
  { y: 200, h: 62, key: '03', missing: true },
  { y: 160, h: 40, key: '04' },
];
---
<Site lang={lang} title={t.title} description={t.description} alternate={href(other(lang), 'home')} noindex>
  <section class="wrap sheet-head nf">
    <div class="nf__text">
      <p class="eyebrow">{t.eyebrow}</p>
      <p class="poster nf__code" aria-hidden="true">404</p>
      <h1 class="title title--xl">{t.h1}</h1>
      <p class="lede">{t.lede}</p>
      <form class="nf__search" method="get" action={href(lang, 'search')} role="search">
        <label class="visually-hidden" for="nf-q">{t.searchLabel}</label>
        <input class="input" id="nf-q" name="q" type="search" placeholder={t.searchLabel} autocomplete="off" />
        <button class="btn" type="submit">{t.searchBtn}</button>
      </form>
      <ul class="nf__links">
        <li><a class="link-arrow" href={href(lang, 'home')}><span>{t.home}</span> <span class="arrow" aria-hidden="true">→</span></a></li>
        <li><a class="link-arrow" href={href(lang, 'shop')}><span>{t.shop}</span> <span class="arrow" aria-hidden="true">→</span></a></li>
        <li><a class="link-arrow" href={href(lang, 'search')}><span>{t.search}</span> <span class="arrow" aria-hidden="true">→</span></a></li>
      </ul>
    </div>
    <figure class="nf__fig" aria-hidden="true">
      <svg viewBox="0 0 520 400" class="nf__svg">
        <line class="nf__ground" x1="10" x2="510" y1="340" y2="340" />
        <path class="nf__roof" d="M90 160 L260 70 L430 160 Z" />
        {layers.map((l) => (
          <g class:list={['nf__layer', { 'is-missing': l.missing }]}>
            <rect x="110" y={l.y} width="300" height={l.h} />
            <text class="nf__key" x="96" y={l.y + l.h / 2 + 5} text-anchor="end">{l.key}</text>
            {l.missing && <text class="nf__miss" x="260" y={l.y + l.h / 2 + 6} text-anchor="middle">{t.missing}</text>}
          </g>
        ))}
        <g class="nf__dim">
          <line x1="440" x2="440" y1="200" y2="262" />
          <line x1="434" x2="446" y1="200" y2="200" />
          <line x1="434" x2="446" y1="262" y2="262" />
          <text x="452" y="236">? mm</text>
        </g>
        <g class="nf__tb">
          <rect x="330" y="356" width="180" height="34" />
          <text x="340" y="378">{t.sheet} 404 · 1:100</text>
        </g>
      </svg>
    </figure>
  </section>
</Site>
