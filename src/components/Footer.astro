---
// Footer: about, the shop in its two groups (renewable energy with the packages and the guide; efficiency and
// building with the whole shop), the company and the legal pages.
import type { Category } from '../lib/catalog';
import { href, type Lang } from '../lib/i18n';
import { categoryHref, categoryName, groupCategories } from '../lib/energy-nav';
import { tc } from '../i18n/common';
import { tr } from '../i18n/renewables';
import { contactSettings } from '../lib/pages-db';
interface Props { lang: Lang; cats: Category[]; }
const { lang, cats } = Astro.props;
const t = tc(lang);
const r = tr(lang).nav;
const groups = groupCategories(cats);
const heading = { energy: t.groups.energy, 'efficiency-build': r.efficiencyBuild } as const;
const year = new Date().getFullYear();
// Contact details only when settings.contact has them (no visible placeholders); NIPT and the operator line always.
const contact = await contactSettings();
const tel = contact.phone ? contact.phone.replace(/[^+\d]/g, '') : '';
---
<footer class="site-footer" data-tone="ink">
  <div class="footer__grid">
    <div class="footer__about">
      <p class="lede" style="color:inherit">{t.footer.about}</p>
    </div>
    <div class="stack-s footer__facts">
      <p class="small mono">{t.footer.operator}{contact.address && <>, {contact.address}</>}{contact.email && <> · <a href={`mailto:${contact.email}`}>{contact.email}</a></>}{contact.phone && <> · <a href={`tel:${tel}`}>{contact.phone}</a></>}</p>
      <p class="small mono">{t.footer.prices}</p>
    </div>
    {groups.map((g) => (
      <div class="footer__col">
        <h2>{heading[g.key]}</h2>
        <ul>
          {g.cats.map((c) => <li><a href={categoryHref(lang, c)}>{categoryName(lang, c)}</a></li>)}
          {g.key === 'energy' ? (
            <>
              <li class="footer__more"><a href={href(lang, 'packages')}>{r.packages}</a></li>
              <li><a href={href(lang, 'guide')}>{r.guide}</a></li>
            </>
          ) : (
            <li class="footer__more"><a href={href(lang, 'shop')}>{t.menu.allShop} →</a></li>
          )}
        </ul>
      </div>
    ))}
    <div class="footer__col">
      <h2>{t.footer.company}</h2>
      <ul>
        <li><a href={href(lang, 'about')}>{t.nav.about}</a></li>
        <li><a href={href(lang, 'sellers')}>{t.nav.sellers}</a></li>
        <li><a href={href(lang, 'sell')}>{t.nav.sell}</a></li>
        <li><a href={href(lang, 'quote')}>{t.nav.quote}</a></li>
        <li><a href={href(lang, 'calculator')}>{t.nav.calculator}</a></li>
        <li><a href={href(lang, 'contact')}>{t.nav.contact}</a></li>
      </ul>
    </div>
    <div class="footer__col">
      <h2>{t.footer.legal}</h2>
      <ul>
        <li><a href={href(lang, 'terms')}>{t.footer.terms}</a></li>
        <li><a href={href(lang, 'terms') + '#kthimet'}>{t.footer.returns}</a></li>
        <li><a href={href(lang, 'terms') + '#dergesa'}>{t.footer.delivery}</a></li>
        <li><a href={href(lang, 'terms') + '#pagesat'}>{t.footer.payments}</a></li>
        <li><a href={href(lang, 'privacy')}>{t.footer.privacy}</a></li>
      </ul>
    </div>
  </div>
  <p class="footer__word" aria-hidden="true">Bee<b>D</b> Energy</p>
  <div class="footer__bottom">
    <span>© {year} BeeD Consulting sh.p.k.</span>
    <span>{t.footer.demo}</span>
    <span class="row" style="gap:.25rem">
      <button class="saver" type="button" aria-pressed="false" data-saver><span class="saver__track" aria-hidden="true"></span><span>{t.saver.label}</span></button>
      <a href="#top" class="link-arrow small">{t.footer.top} ↑</a>
    </span>
  </div>
</footer>
