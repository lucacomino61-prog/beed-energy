---
// A product's technical drawing at its datasheet dimensions (src/lib/drawing.ts). Decorative in cards (the link names the product).
import { drawProduct } from '../lib/drawing';
interface Props {
  category: string; // categories.slug_en
  w: number | null;
  h: number | null;
  d: number | null;
  specs?: Record<string, unknown>;
  dims?: boolean;
  title?: string;
  decorative?: boolean;
  class?: string;
}
const { category, w, h, d, specs = {}, dims = false, title = '', decorative = false, class: cls } = Astro.props;
let svg = drawProduct({ category, w, h, d, specs, dims, title: decorative ? undefined : title });
if (decorative) svg = svg.replace('role="img" aria-label=""', 'aria-hidden="true" focusable="false"');
---
<div class:list={['pdraw', cls]} set:html={svg} />
