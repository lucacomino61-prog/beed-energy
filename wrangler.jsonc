{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beed-energy",
  "compatibility_date": "2026-10-01",
  // nodejs_compat covers node:crypto (scrypt for the staff password hashes) and node:async_hooks
  // (AsyncLocalStorage, which carries the D1 binding into src/lib/db.ts).
  "compatibility_flags": ["nodejs_compat"],
  // `main` and the static assets are the adapter's: @astrojs/cloudflare points them at its own build
  // output, so setting them here only fights it.
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beed-energy",
      // From `wrangler d1 create beed-energy` (region EEUR). Local dev keys its own copy by this id too.
      "database_id": "cb2d74a3-924a-48b8-9e98-e3705ad83155",
      "migrations_dir": "migrations"
    }
  ],
  // Product photos uploaded in the admin panel (src/lib/media.ts), served from /media/…. KV rather
  // than R2 only because R2 is not enabled on this account; media.ts is the one file to change.
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "b8ef5aedaef7428c8f026168cd62cc7f"
    }
  ]
  // Secrets are not kept here. Set the POK card keys with `wrangler secret put POK_KEY_ID` (and
  // POK_KEY_SECRET, POK_MERCHANT_ID); POK_ENV=staging points them at POK's test API. Local values
  // for `astro dev` / `wrangler dev` go in .dev.vars (see .dev.vars.example).
}
